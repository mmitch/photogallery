source test-framework

test_start photogallery-001-happypath

### GIVEN

cp pics/*.jpg "$tmpdir"
echo 'gallery description' >  "$tmpdir"/README
echo 'descriptive text' > "$tmpdir"/green.jpg.text

### WHEN

cd "$tmpdir"
"$repodir/photogallery" --dark "Gallery title"

### THEN

assert_file_exists index.html
assert_file_content_equals index.html "$expectdir"/index.html

for pic in blue.jpg green.jpg red.jpg; do
    
    assert_file_exists $pic
    assert_file_exists .webthumbs/${pic}_m.jpg
    assert_file_exists .webthumbs/${pic}_s.jpg

    assert_file_exists .webthumbs/${pic}_m.html
    assert_file_content_equals .webthumbs/${pic}_m.html "$expectdir"/${pic}_m.html

done

test_end
